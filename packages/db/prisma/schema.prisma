// Prisma schema for Pulse.
// S01: the walking skeleton — a single, deliberately-naive `Event` table in Postgres. This is THE baseline the
// whole course measures against: no partitioning, no columnar store, a synchronous insert on the hot path. It
// is correct, and ADR-0002 writes down the numeric exit criteria at which it stops being enough — S07 measures
// us across that line and migrates the events store to ClickHouse. Metadata (projects, persons, flags) stays in
// Postgres; the OLTP/OLAP split is forced by S07, not guessed now.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Tenancy & machine auth (S02) ────────────────────────────────────────────────
// An Org owns Projects; a Project owns ApiKeys and (logically) events. Org/user/session auth is a
// fast-forward from prior courses; the NEW material is machine auth — two key TYPES with different
// audiences (see ApiKey). Metadata lives in Postgres and stays here even after S07 moves events to
// ClickHouse, which is exactly why Event carries a bare projectId String and NOT a foreign key to
// Project: you cannot enforce a cross-store FK, and pretending you can is a lie the migration would
// expose. The boundary is drawn now, on purpose.

model Org {
  id        String       @id @default(cuid())
  name      String
  createdAt DateTime     @default(now())
  projects  Project[]
  members   Membership[]
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  createdAt   DateTime     @default(now())
  memberships Membership[]
}

model Membership {
  id     String @id @default(cuid())
  orgId  String
  userId String
  role   String @default("member") // owner | admin | member
  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
}

model Project {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  createdAt DateTime @default(now())
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  apiKeys   ApiKey[]

  @@index([orgId])
}

// The identity graph (S06). A Person is one human; the many browser/user distinctIds they accumulate all point
// at them through DistinctIdMapping. Resolution happens on the WRITE path (the consumer) and freezes a personId
// onto each event — so a later merge changes only the mapping table, never the immutable event rows.
model Person {
  id         String              @id @default(cuid())
  projectId  String
  properties Json                @default("{}")
  createdAt  DateTime            @default(now())
  mappings   DistinctIdMapping[]

  @@index([projectId])
}

model DistinctIdMapping {
  id         String   @id @default(cuid())
  projectId  String
  distinctId String
  personId   String
  createdAt  DateTime @default(now())
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  // One distinctId maps to exactly one person per project — the unique constraint that turns the create-on-
  // first-sight race into a caught error instead of a silent duplicate.
  @@unique([projectId, distinctId])
  @@index([personId])
}

// A saved insight (S05) is a stored QUERY DEFINITION, not stored results. Persisting the definition (a
// versioned TrendSpec JSON) — not a materialized answer — is what lets S07 swap the query backend
// (Postgres → ClickHouse) under a hundred saved insights without touching any of them: migrate the compiler,
// not the data. `defVersion` lets the compiler evolve the spec format while old insights keep resolving.
model Insight {
  id         String   @id @default(cuid())
  projectId  String
  name       String
  // Which query language the definition speaks: "trend" (S05) or "funnel" (S08). Same versioned-definition
  // pattern — the compiler is chosen by kind + version, so both survive engine swaps.
  defKind    String   @default("trend")
  defVersion Int      @default(1)
  definition Json // a TrendSpec or FunnelSpec (see @pulse/insights)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([projectId])
}

// Dashboards (S10): a grid of tiles, each referencing a saved Insight. ShareToken makes a dashboard publicly
// readable without a session — a random token, hashed at rest like an API key.
model Dashboard {
  id        String          @id @default(cuid())
  projectId String
  name      String
  createdAt DateTime        @default(now())
  tiles     DashboardTile[]
  shares    ShareToken[]

  @@index([projectId])
}

model DashboardTile {
  id          String    @id @default(cuid())
  dashboardId String
  insightId   String // the saved Insight this tile renders
  x           Int       @default(0)
  y           Int       @default(0)
  w           Int       @default(4)
  h           Int       @default(3)
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId])
}

// A public share token for a dashboard (S10). Stored as a hash + prefix (Stripe-shaped, like ApiKey).
// NOTE (S10): no expiry, no revocation list yet — revisited in S13 hardening.
model ShareToken {
  id          String    @id @default(cuid())
  dashboardId String
  hash        String    @unique
  prefix      String
  createdAt   DateTime  @default(now())
  // S13 (harvests flaw #5): links now expire, and can be revoked. A null expiresAt means "no expiry" (legacy);
  // new tokens always get one. revokedAt is set by the revoke endpoint — a killed link dies immediately.
  expiresAt   DateTime?
  revokedAt   DateTime?
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId])
}

// Feature flag (S14): a named decision evaluated per user by deterministic bucketing (NOT a stored assignment).
// `variants` is [{key,weight}]; `targeting` reuses the S09 cohort filter grammar (Filter[]). The api ships these
// rows to SDKs as a payload; every evaluator buckets the same way, so no per-user assignment is ever persisted.
model FeatureFlag {
  id                String   @id @default(cuid())
  projectId         String
  key               String
  enabled           Boolean  @default(true)
  rolloutPercentage Int      @default(100)
  variants          Json
  targeting         Json     @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  experiments Experiment[]

  @@unique([projectId, key])
  @@index([projectId])
}

// Experiment (S14): a flag-linked A/B test with a REQUIRED hypothesis (scientific hygiene), a goal metric, and a
// lifecycle. Exposure→goal conversion per variant drives the significance test. Assignment is never stored — the
// flag's bucketing decides the variant; we only record EXPOSURE events (who actually saw the difference).
model Experiment {
  id          String    @id @default(cuid())
  projectId   String
  flagId      String
  name        String
  hypothesis  String
  goalEvent   String
  status      String    @default("draft") // draft | running | stopped
  startedAt   DateTime?
  stoppedAt   DateTime?
  createdAt   DateTime  @default(now())
  flag        FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([flagId])
}

// GDPR deletion-request ledger (S13): the compliance evidence trail. One row per erasure request with its
// outcome — so "we deleted this person" is provable months later, not just asserted. `remaining` must be 0 for
// a completed request; a non-zero count marks the sweep failed and demands a re-run.
model DeletionRequest {
  id          String    @id @default(cuid())
  personId    String
  status      String    @default("pending") // pending | completed | failed
  distinctIds String[]
  rowsDeleted Int?
  remaining   Int?
  requestedAt DateTime  @default(now())
  completedAt DateTime?

  @@index([personId])
}

// A cohort (S09): a named set of people, defined by ONE AST (property predicate or behavioral: did event X ≥ N
// times in a window). Property cohorts compile live; behavioral cohorts are materialized into CohortMembership
// by a scheduled job, with `membersComputedAt` as the staleness contract shown to analysts (ADR-0008).
model Cohort {
  id               String             @id @default(cuid())
  projectId        String
  name             String
  kind             String // "property" | "behavioral"
  definition       Json // a CohortSpec (see @pulse/insights)
  membersComputedAt DateTime? // behavioral only: when membership was last recomputed
  createdAt        DateTime           @default(now())
  members          CohortMembership[]

  @@index([projectId])
}

// Materialized behavioral-cohort membership (one row per person in the cohort as of the last recompute).
model CohortMembership {
  cohortId String
  personId String
  cohort   Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@id([cohortId, personId])
  @@index([personId])
}

// A credential's capability follows its audience. A WRITE key ships in public page source to strangers,
// so it may only APPEND events; a SECRET key never leaves a server, so it may READ. The type is readable
// from the plaintext prefix (pw_live_… / ps_live_…), stored so support can identify a key without ever
// seeing it. The plaintext is shown ONCE at issuance and only its sha256 `hash` is stored — if you can
// show a key twice, you stored it wrong. (Rotation + per-key rate limits are deferred to S13.)
enum ApiKeyType {
  WRITE
  SECRET
}

model ApiKey {
  id         String     @id @default(cuid())
  projectId  String
  type       ApiKeyType
  hash       String     @unique // sha256(plaintext); the plaintext is never stored
  prefix     String // e.g. "pw_live_ab12" — identifiable but not secret (support/debug)
  label      String     @default("")
  // Optional per-key origin allowlist (S02 debate). Empty = allow any origin. Enforced only for
  // browser-shaped requests (those carrying an Origin header); it is abuse REDUCTION, not security,
  // because Origin is trivially spoofed outside a browser. See ADR-0003.
  allowedOrigins String[] @default([])
  lastUsedAt DateTime? // written by SAMPLED update (~1%), never on every event — see resolver
  revokedAt  DateTime?
  createdAt  DateTime   @default(now())
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// One row per tracked action. `props` is a schemaless JSONB bag (the event's shape is the SDK caller's, not
// ours). `ts` is EVENT time (client clock — trusted in S1, a flaw revisited in S04/S13); `ingestedAt` is
// SERVER time. `projectId` is now resolved from a write key (S02) but stays a bare String with NO foreign
// key to Project on purpose: events migrate to ClickHouse in S07, and a cross-store FK cannot be enforced.
//
// ARCHIVED (S07 decommission): the events store is now ClickHouse. The consumer no longer writes to this table
// (EVENTS_PRIMARY=ch), and the app API reads events from ClickHouse. This model is kept read-only for the
// historical archive and any one-off backfill re-runs; new writes go to CH. Do not re-point writes here.
model Event {
  id         String   @id @default(cuid())
  // Client-minted idempotency key (SDK envelope → ingest → stream). The unique index is the dedup mechanism:
  // a re-delivered event hits ON CONFLICT DO NOTHING and inserts nothing, turning at-least-once delivery into
  // effective exactly-once. NOTE (S07): a unique btree over every event's uuid grows unbounded — the columnar
  // store can't enforce it, so S07 must re-solve dedup (TTL'd dedup set / merge-time dedup).
  uuid       String   @unique
  projectId  String   @default("demo-project")
  distinctId String
  // Resolved on the WRITE path (S06) and frozen here. Unique-user queries count distinct personId, not
  // distinctId — the true count once identity merges collapse a person's many ids. Nullable for events
  // predating identity resolution.
  personId   String?
  name       String
  props      Json     @default("{}")
  ts         DateTime // event time
  ingestedAt DateTime @default(now()) // server time

  // The naive index: by project + event time, for the daily-counts scan. BRIN vs btree, partitioning, and the
  // columnar rethink are deferred — S07's job, once the numbers demand it.
  @@index([projectId, ts])
}
